# O Coolify gera e persiste automaticamente estas duas variaveis magicas.
SERVICE_PASSWORD_64_POSTGRES=
SERVICE_REALBASE64_32_NEXT_SERVER_ACTIONS=

# URL publica usada nos links absolutos e nas pre-visualizacoes do WhatsApp.
APP_URL=https://pdv.seu-dominio.com.br

# Use true somente no primeiro deploy; depois altere para false e redeploy.
SEED_ON_DEPLOY=true
SEED_ADMIN_EMAIL=admin@seu-dominio.com
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_EMAIL=operador@seu-dominio.com
SEED_OPERATOR_PASSWORD=
SESSION_TTL_HOURS=12
TOTP_ENCRYPTION_KEY=gere-uma-chave-aleatoria-longa-e-secreta
BACKUP_RETENTION_DAYS=14
HEALTH_MIN_STORAGE_FREE_PERCENT=10

# Acesso direto temporario em http://IP_DA_VPS:3000.
APP_PORT=3000
SESSION_COOKIE_SECURE=false
